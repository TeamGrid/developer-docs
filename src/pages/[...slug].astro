---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import DocsLayout from '../layouts/DocsLayout.astro'
import { docPath, sourcePath } from '../lib/content'

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ id, data }) =>
    !data.draft && id !== 'index' && id !== '404',
  )
  return entries.map((entry) => ({
    params: { slug: docPath(entry).replace(/^\/|\/$/g, '') },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'docs'>
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
  source={sourcePath(entry)}
  owner={entry.data.owner}
  reviewedAt={entry.data.reviewedAt}
>
  <Content />
</DocsLayout>
