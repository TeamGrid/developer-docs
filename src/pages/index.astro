---
import type { MarkdownHeading } from 'astro'
import contractManifest from '../../sources/contracts.json'
import DocsLayout from '../layouts/DocsLayout.astro'
import { currentDeveloperRelease } from '../data/releases'
import { apiOperations } from '../lib/openapi'

const stableOperationCount = apiOperations('v1').length
const stableContractVersion = contractManifest.canonical.contractVersion
const latestRelease = currentDeveloperRelease
const headings: MarkdownHeading[] = [
  { depth: 2, slug: 'choose-an-interface', text: 'Choose an interface' },
  { depth: 2, slug: 'make-the-first-request', text: 'Make the first request' },
  { depth: 2, slug: 'build-a-real-workflow', text: 'Build a real workflow' },
  { depth: 2, slug: 'prepare-for-production', text: 'Prepare for production' },
]

const interfaces = [
  {
    name: 'API v1',
    meta: 'HTTP · OpenAPI 3.1',
    description:
      'Use the stable regional HTTP contract directly from a service, product integration or generated client.',
    href: '/api/v1/',
    link: 'Read the API overview',
  },
  {
    name: 'TypeScript SDK',
    meta: '@teamgrid/api-client',
    description:
      'Work with typed resources, cursor iteration and bounded retries without rebuilding the HTTP layer.',
    href: '/sdk/',
    link: 'Open the SDK guide',
  },
  {
    name: 'CLI',
    meta: '@teamgrid/cli',
    description:
      'Inspect workspace data and run repeatable TeamGrid operations locally or from a CI pipeline.',
    href: '/cli/',
    link: 'Install the CLI',
  },
  {
    name: 'MCP server',
    meta: '@teamgrid/mcp-server',
    description:
      'Expose a deliberately bounded TeamGrid tool surface to compatible, supervised assistants.',
    href: '/mcp/',
    link: 'Review MCP access',
  },
]

const workflows = [
  {
    title: 'Synchronize tasks',
    description:
      'Import the current state, follow the change feed and handle concurrent updates explicitly.',
    href: '/guides/sync-tasks/',
  },
  {
    title: 'Export time entries',
    description:
      'Move approved time data into finance, reporting or a data warehouse with stable pagination.',
    href: '/guides/export-time-entries/',
  },
  {
    title: 'Automate project setup',
    description:
      'Create repeatable project structures safely from a service, script or deployment job.',
    href: '/guides/automate-project-setup/',
  },
  {
    title: 'Process webhooks reliably',
    description:
      'Verify signatures, acknowledge deliveries quickly and process each event idempotently.',
    href: '/guides/reliable-webhooks/',
  },
]
---

<DocsLayout
  title="Welcome to TeamGrid Developer"
  description="Build dependable integrations with TeamGrid API v1, the official TypeScript SDK, the CLI, and the TeamGrid MCP server."
  headings={headings}
  source="src/pages/index.astro"
  owner="Developer Platform"
  reviewedAt={new Date('2026-08-10')}
>
  <div class="welcome-page">
    <dl class="welcome-summary">
      <div>
        <dt>Stable contract</dt>
        <dd>API v1 · {stableContractVersion}</dd>
      </div>
      <div>
        <dt>Reference</dt>
        <dd>{stableOperationCount} operations</dd>
      </div>
      <div>
        <dt>Production regions</dt>
        <dd>Germany and United States</dd>
      </div>
    </dl>

    <section aria-labelledby="choose-an-interface">
      <h2 id="choose-an-interface">Choose an interface</h2>
      <p>
        API, SDK, CLI and MCP use the same regional credentials, scopes and resource semantics.
        Choose the interface that fits where your integration runs; you do not need to learn a
        second TeamGrid platform. If you are new to the platform, follow the
        <a href="/guides/learning-paths/">guided learning path</a> for that interface.
      </p>

      <div class="welcome-interface-grid">
        {interfaces.map((item) => (
          <a class="welcome-interface" href={item.href}>
            <span>{item.meta}</span>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <strong>{item.link} <i aria-hidden="true">→</i></strong>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="make-the-first-request">
      <h2 id="make-the-first-request">Make the first request</h2>
      <p>
        Begin with the read-only workspace endpoint. It confirms that the credential is valid,
        reaches the correct production region and can access the expected TeamGrid workspace.
      </p>

      <div class="welcome-request">
        <ol>
          <li>
            <span>1</span>
            <div>
              <strong>Create a scoped credential</strong>
              <p>Open Developer settings in TeamGrid and grant <code>workspace:read</code>.</p>
            </div>
          </li>
          <li>
            <span>2</span>
            <div>
              <strong>Store the token outside source code</strong>
              <p>Use an environment variable or the profile store provided by the TeamGrid CLI.</p>
            </div>
          </li>
          <li>
            <span>3</span>
            <div>
              <strong>Call the regional endpoint</strong>
              <p>A successful response identifies the workspace, region and API contract.</p>
            </div>
          </li>
        </ol>

        <div class="welcome-request__example">
          <div>
            <span>Read-only request</span>
            <strong>200 OK</strong>
          </div>
          <pre><code>curl --fail-with-body \
  --header "Authorization: Bearer $TEAMGRID_API_TOKEN" \
  https://api.de.teamgrid.app/v1/workspace</code></pre>
          <div>
            <code>workspace:read</code>
            <a href="/api/v1/quickstart/">Open the quickstart →</a>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="build-a-real-workflow">
      <h2 id="build-a-real-workflow">Build a real workflow</h2>
      <p>
        The implementation guides continue beyond a successful example request. They cover
        permissions, pagination, retries, verification and the failure cases that matter in
        production.
      </p>

      <nav class="welcome-workflows" aria-label="Integration guides">
        {workflows.map((workflow, index) => (
          <a href={workflow.href}>
            <span>0{index + 1}</span>
            <div>
              <strong>{workflow.title}</strong>
              <p>{workflow.description}</p>
            </div>
            <i aria-hidden="true">→</i>
          </a>
        ))}
      </nav>
    </section>

    <section aria-labelledby="prepare-for-production">
      <h2 id="prepare-for-production">Prepare for production</h2>
      <p>
        Credentials carry a region and explicit scopes. Writes use idempotency keys or resource
        revisions where the operation requires them. Keep those boundaries visible in your
        implementation from the beginning.
      </p>

      <div class="welcome-production">
        <div>
          <h3>Before you ship</h3>
          <ul>
            <li><a href="/api/v1/authentication/">Review credentials and required scopes</a></li>
            <li><a href="/api/v1/regions/">Confirm regional routing</a></li>
            <li><a href="/api/v1/errors/">Implement errors, rate limits and retries</a></li>
            <li><a href="/api/v1/resource-concurrency/">Protect concurrent writes</a></li>
            <li><a href="/guides/production-go-live/">Complete the production go-live checklist</a></li>
          </ul>
        </div>
        <aside>
          <span>Current release</span>
          <strong>{latestRelease.title}</strong>
          <p>{latestRelease.description}</p>
          <div>
            <a href="/changelog/">Read the changelog</a>
            <a href="https://status.teamgrid.app/">Platform status ↗</a>
          </div>
        </aside>
      </div>
    </section>
  </div>
</DocsLayout>

<style>
  .welcome-page {
    --welcome-blue: #4169e8;
    --welcome-blue-dark: #2f54cf;
    --welcome-blue-soft: #f2f5ff;
    --welcome-ink: #20242c;
    --welcome-copy: #656c78;
    --welcome-muted: #8b919b;
    --welcome-rule: #dfe2e7;
  }

  .welcome-page > section {
    margin-top: 72px;
    padding-top: 4px;
  }

  .welcome-page > section > h2 {
    margin-top: 0;
  }

  .welcome-page > section > p {
    max-width: 690px;
  }

  .welcome-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 10px 0 0;
    overflow: hidden;
    border: 1px solid var(--welcome-rule);
    border-radius: 12px;
    background: #fff;
  }

  .welcome-summary > div {
    padding: 18px 20px;
    border-right: 1px solid var(--welcome-rule);
  }

  .welcome-summary > div:last-child {
    border-right: 0;
  }

  .welcome-summary dt {
    color: var(--welcome-muted);
    font-size: 10px;
  }

  .welcome-summary dd {
    margin: 5px 0 0;
    color: var(--welcome-ink);
    font-size: 12px;
    font-weight: 680;
  }

  .welcome-interface-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 28px;
  }

  .welcome-interface {
    display: flex;
    min-height: 220px;
    flex-direction: column;
    padding: 24px;
    border: 1px solid var(--welcome-rule);
    border-radius: 12px;
    color: inherit;
    background: #fff;
    text-decoration: none;
    transition:
      border-color 140ms ease,
      transform 140ms ease;
  }

  .welcome-interface:hover {
    border-color: #b8c6f5;
    transform: translateY(-1px);
  }

  .welcome-interface > span {
    color: var(--welcome-muted);
    font-size: 10px;
  }

  .welcome-interface h3 {
    margin: 18px 0 0;
    color: var(--welcome-ink);
    font-size: 20px;
    letter-spacing: -0.025em;
  }

  .welcome-interface p {
    margin: 10px 0 20px;
    color: var(--welcome-copy);
    font-size: 12px;
    line-height: 1.62;
  }

  .welcome-interface > strong {
    margin-top: auto;
    color: var(--welcome-blue-dark);
    font-size: 11px;
  }

  .welcome-interface > strong i {
    margin-left: 6px;
    font-style: normal;
  }

  .welcome-request {
    display: grid;
    grid-template-columns: minmax(260px, 0.82fr) minmax(360px, 1.18fr);
    gap: 32px;
    align-items: center;
    margin-top: 30px;
    padding: 30px;
    border: 1px solid var(--welcome-rule);
    border-radius: 12px;
    background: #f8f9fb;
  }

  .welcome-request ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .welcome-request li {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 12px;
    padding: 15px 0;
    border-bottom: 1px solid var(--welcome-rule);
  }

  .welcome-request li:first-child {
    padding-top: 0;
  }

  .welcome-request li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .welcome-request li > span {
    color: var(--welcome-blue-dark);
    font-size: 11px;
    font-weight: 680;
  }

  .welcome-request li strong {
    color: var(--welcome-ink);
    font-size: 12px;
  }

  .welcome-request li p {
    margin: 4px 0 0;
    color: var(--welcome-copy);
    font-size: 10px;
    line-height: 1.5;
  }

  .welcome-request li code {
    font-size: 9px;
  }

  .welcome-request__example {
    overflow: hidden;
    border: 1px solid #31343b;
    border-radius: 11px;
    color: #cbd0d8;
    background: #1c1e23;
  }

  .welcome-request__example > div {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 0 16px;
    border-bottom: 1px solid #353841;
    color: #8b909b;
    font-size: 9px;
  }

  .welcome-request__example > div:last-child {
    border-top: 1px solid #353841;
    border-bottom: 0;
  }

  .welcome-request__example > div > strong {
    color: #79c397;
    font-size: 9px;
  }

  .welcome-request__example > div > code {
    color: #aebdf7;
    font-size: 8px;
  }

  .welcome-request__example > div > a {
    color: #c0cbf8;
    font-size: 9px;
  }

  .welcome-request__example pre {
    margin: 0;
    padding: 22px 18px;
    overflow: auto;
    border: 0;
    border-radius: 0;
    color: #d8dbe1;
    background: transparent;
    font-size: 9px;
    line-height: 1.75;
    white-space: pre;
  }

  .welcome-workflows {
    margin-top: 28px;
    border-top: 1px solid var(--welcome-ink);
  }

  .welcome-workflows a {
    display: grid;
    grid-template-columns: 38px 1fr 18px;
    gap: 18px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--welcome-rule);
    color: inherit;
    text-decoration: none;
  }

  .welcome-workflows a > span {
    color: var(--welcome-blue-dark);
    font-size: 10px;
    font-weight: 680;
  }

  .welcome-workflows strong {
    color: var(--welcome-ink);
    font-size: 14px;
  }

  .welcome-workflows p {
    margin: 6px 0 0;
    color: var(--welcome-copy);
    font-size: 11px;
    line-height: 1.55;
  }

  .welcome-workflows i {
    color: var(--welcome-ink);
    font-size: 16px;
    font-style: normal;
  }

  .welcome-production {
    display: grid;
    grid-template-columns: 1fr 0.92fr;
    gap: 18px;
    margin-top: 28px;
  }

  .welcome-production > div,
  .welcome-production > aside {
    padding: 24px;
    border: 1px solid var(--welcome-rule);
    border-radius: 12px;
  }

  .welcome-production h3 {
    margin: 0 0 16px;
    color: var(--welcome-ink);
    font-size: 16px;
  }

  .welcome-production ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .welcome-production li {
    border-top: 1px solid var(--welcome-rule);
  }

  .welcome-production li a {
    display: block;
    padding: 11px 0;
    color: var(--welcome-ink);
    font-size: 11px;
    text-decoration: none;
  }

  .welcome-production li a::after {
    float: right;
    color: var(--welcome-muted);
    content: "→";
  }

  .welcome-production > aside {
    background: var(--welcome-blue-soft);
  }

  .welcome-production > aside > span {
    color: var(--welcome-blue-dark);
    font-size: 10px;
    font-weight: 650;
  }

  .welcome-production > aside > strong {
    display: block;
    margin-top: 12px;
    color: var(--welcome-ink);
    font-size: 20px;
  }

  .welcome-production > aside > p {
    margin: 12px 0 0;
    color: var(--welcome-copy);
    font-size: 11px;
    line-height: 1.6;
  }

  .welcome-production > aside > div {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 23px;
    padding-top: 18px;
    border-top: 1px solid #ccd7fa;
  }

  .welcome-production > aside a {
    color: var(--welcome-blue-dark);
    font-size: 10px;
    font-weight: 650;
  }

  @media (max-width: 760px) {
    .welcome-summary,
    .welcome-interface-grid,
    .welcome-request,
    .welcome-production {
      grid-template-columns: 1fr;
    }

    .welcome-summary > div,
    .welcome-summary > div:last-child {
      border-right: 0;
      border-bottom: 1px solid var(--welcome-rule);
    }

    .welcome-summary > div:last-child {
      border-bottom: 0;
    }

    .welcome-interface {
      min-height: 0;
    }

    .welcome-request {
      padding: 20px;
    }

    .welcome-request__example pre {
      font-size: 8px;
    }
  }
</style>
