{
  "package": {
    "name": "@teamgrid/mcp-server",
    "sourceCommit": "b0e4b3dfa4afd74822a73b8b5e8b647236f273ce",
    "sourceRepository": "TeamGrid/developer-platform",
    "version": "1.2.2"
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": true,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "contract": {
    "domain": "schedule-write",
    "concurrency": "conditional",
    "idempotency": true,
    "coreCas": false
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "data": {
        "$ref": "#/$defs/PlannedWorkOperation"
      },
      "meta": {
        "additionalProperties": false,
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Unique identifier assigned to the API request for tracing and support."
          },
          "privateResource": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "maxBytes",
              "readMethod"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "pattern": "^teamgrid://(?:files|exports)/[A-Za-z0-9_.:%-]+$"
              },
              "maxBytes": {
                "const": 1048576
              },
              "readMethod": {
                "const": "resources/read"
              }
            }
          },
          "etag": {
            "type": "string",
            "pattern": "^\"[\\x21\\x23-\\x7e]{1,256}\"$"
          },
          "resume": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "arguments"
            ],
            "properties": {
              "tool": {
                "enum": [
                  "teamgrid_project_lifecycle_operation_get",
                  "teamgrid_planned_work_operation_get",
                  "teamgrid_task_recurrence_operation_get",
                  "teamgrid_export_get"
                ]
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          },
          "outcome": {
            "enum": [
              "completed",
              "accepted",
              "partial",
              "unknown",
              "failed"
            ]
          },
          "omittedFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contentReadTool": {
            "const": "teamgrid_document_get"
          },
          "contentPage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unit": {
                "const": "utf16"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "nextOffset": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "totalLength": {
                "type": "integer",
                "minimum": 0
              },
              "complete": {
                "type": "boolean"
              },
              "revision": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "unit",
              "offset",
              "nextOffset",
              "totalLength",
              "complete",
              "revision"
            ]
          },
          "search": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "complete": {
                "const": false
              },
              "indexed": {
                "const": true
              },
              "returned": {
                "type": "integer",
                "minimum": 0
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 50
              },
              "continuation": {
                "const": "narrow-query-or-list"
              },
              "verification": {
                "const": "read-by-id"
              }
            },
            "required": [
              "complete",
              "indexed",
              "returned",
              "limit",
              "continuation",
              "verification"
            ]
          }
        },
        "required": [
          "requestId"
        ],
        "type": "object",
        "description": "Public API representation of meta."
      }
    },
    "required": [
      "data",
      "meta"
    ],
    "additionalProperties": false,
    "$defs": {
      "PlannedWorkOperation": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "failed"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "properties": {
                    "error": true,
                    "finishedAt": true
                  },
                  "required": [
                    "error",
                    "finishedAt"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "succeeded"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "not": {
                    "properties": {
                      "error": true
                    },
                    "required": [
                      "error"
                    ]
                  },
                  "properties": {
                    "finishedAt": true
                  },
                  "required": [
                    "finishedAt"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "pending"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "properties": {
                          "error": true
                        },
                        "required": [
                          "error"
                        ]
                      },
                      {
                        "properties": {
                          "finishedAt": true
                        },
                        "required": [
                          "finishedAt"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "running"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "not": {
                    "properties": {
                      "finishedAt": true
                    },
                    "required": [
                      "finishedAt"
                    ]
                  }
                }
              }
            ],
            "properties": {
              "attempts": {
                "minimum": 0,
                "type": "integer",
                "description": "The attempts associated with this planned work operation attributes."
              },
              "createdAt": {
                "format": "date-time",
                "type": "string",
                "description": "Timestamp at which the resource was created."
              },
              "error": {
                "additionalProperties": false,
                "properties": {
                  "code": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9_.-]+$",
                    "type": "string",
                    "description": "Stable machine-readable code for programmatic error or state handling."
                  },
                  "message": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string",
                    "description": "Human-readable explanation intended to help diagnose the result."
                  }
                },
                "readOnly": true,
                "required": [
                  "code",
                  "message"
                ],
                "type": "object",
                "description": "Sanitized failure information when the operation did not succeed."
              },
              "finishedAt": {
                "format": "date-time",
                "readOnly": true,
                "type": "string",
                "description": "ISO 8601 timestamp for finished at."
              },
              "plannedEnd": {
                "format": "date-time",
                "type": "string",
                "description": "Planned end timestamp."
              },
              "plannedStart": {
                "format": "date-time",
                "type": "string",
                "description": "Planned start timestamp."
              },
              "projectId": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Identifier of the related project."
              },
              "sourceRevision": {
                "pattern": "^pw1-[a-f0-9]{64}$",
                "type": "string",
                "description": "Revision of the source resource accepted when the asynchronous operation was created."
              },
              "state": {
                "enum": [
                  "failed",
                  "pending",
                  "running",
                  "succeeded"
                ],
                "type": "string",
                "description": "Canonical lifecycle state of the resource or operation."
              },
              "targetRevision": {
                "pattern": "^pw1-[a-f0-9]{64}$",
                "type": "string",
                "description": "The target revision associated with this planned work operation attributes."
              },
              "taskId": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Identifier of the related task."
              },
              "updatedAt": {
                "format": "date-time",
                "type": "string",
                "description": "Timestamp of the most recent successful update."
              },
              "userId": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "type": "string",
                "description": "Identifier of the related workspace user."
              }
            },
            "required": [
              "attempts",
              "createdAt",
              "plannedEnd",
              "plannedStart",
              "projectId",
              "sourceRevision",
              "state",
              "targetRevision",
              "taskId",
              "updatedAt",
              "userId"
            ],
            "type": "object",
            "description": "The attributes associated with this planned work operation."
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
            "description": "Stable TeamGrid identifier for this resource."
          },
          "type": {
            "const": "plannedWorkOperation",
            "type": "string",
            "description": "Canonical type discriminator for this resource."
          }
        },
        "required": [
          "attributes",
          "id",
          "type"
        ],
        "type": "object",
        "description": "Public API representation of planned work operation."
      }
    }
  },
  "profileOutputSchemas": {},
  "exposure": "gated-write",
  "apiOperations": [
    {
      "href": "/api/v1/reference/operations/replacetaskplannedwork/",
      "method": "PUT",
      "operationId": "replaceTaskPlannedWork",
      "path": "/tasks/{id}/planned-work"
    }
  ],
  "availableIn": [
    "full",
    "schedule-write"
  ],
  "baseProfile": "full",
  "description": "Replace task planned work asynchronously. Changes the selected workspace under current API permissions. Read the target first; submit its exact ETag. On conflict, review the current state before making a new decision. Reuse the same idempotencyKey and payload for the same intent. Acceptance is not completion. Use the corresponding operation-get tool to inspect the returned operation until terminal.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspaceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Workspace returned by teamgrid_workspace_get and selected for this exact action."
      },
      "id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "expectedRevision": {
        "pattern": "^\"pw1-[a-f0-9]{64}\"$",
        "type": "string",
        "description": "Exact strong ETag (including quotes) from the read reviewed for this action. Never replace it automatically after a conflict."
      },
      "idempotencyKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[\\x21-\\x7e]+$",
        "description": "Stable key for this exact intent. Retain and reuse the same key and payload after a timeout; a timeout does not prove failure."
      },
      "data": {
        "additionalProperties": false,
        "properties": {
          "dayLoads": {
            "items": {
              "maximum": 1440,
              "minimum": 0,
              "type": "number"
            },
            "maxItems": 366,
            "type": "array",
            "description": "The day loads associated with this planned work replacement."
          },
          "plannedEnd": {
            "format": "date-time",
            "type": "string",
            "description": "Planned end timestamp."
          },
          "plannedStart": {
            "format": "date-time",
            "type": "string",
            "description": "Planned start timestamp."
          }
        },
        "required": [
          "dayLoads",
          "plannedEnd",
          "plannedStart"
        ],
        "type": "object",
        "description": "Public API representation of planned work replacement."
      }
    },
    "required": [
      "workspaceId",
      "id",
      "expectedRevision",
      "idempotencyKey",
      "data"
    ],
    "additionalProperties": false
  },
  "profileInputSchemas": {},
  "name": "teamgrid_task_planned_work_replace",
  "scopes": {
    "optional": [],
    "conditional": [],
    "required": [
      "planned-work:write",
      "workspace:read"
    ]
  },
  "security": {
    "classification": "workspace-mutation",
    "summary": "This changes workspace state and may trigger business or external effects. Use its exact scope, revision and idempotency contract; profile selection grants no authority."
  },
  "output": {
    "format": "A compact mutation receipt includes target and revision when available; outcome metadata distinguishes accepted, complete, partial and uncertain results.",
    "kind": "mutation-receipt",
    "maxSerializedBytes": 262144,
    "pagination": null,
    "redactions": [],
    "searchLimit": null
  },
  "examplePrompt": "Prepare a teamgrid_task_planned_work_replace operation for my chosen target. Resolve IDs, read current state and revisions, show the intended change, then report its confirmed or uncertain outcome without automatic retries.",
  "typicalErrors": [
    {
      "condition": "The selected tool profile or allow/deny filter excludes `teamgrid_task_planned_work_replace`.",
      "result": "The tool is not advertised to the host. Select the narrowest profile that contains it and restart the host."
    },
    {
      "condition": "`id` is missing or violates this tool’s exact input schema, including any pattern or length restriction.",
      "result": "MCP input validation rejects the call before an API request is made."
    },
    {
      "condition": "The credential lacks `planned-work:write` and `workspace:read` or cannot access the requested resource.",
      "result": "The tool preserves a safe API error code such as `insufficient_scope`, with redacted detail and available status/request metadata."
    },
    {
      "condition": "The connection ends while awaiting the write result.",
      "result": "Inspect the outcome and status/resume information. An interrupted wait does not prove rollback; never blindly repeat the write."
    },
    {
      "condition": "An unknown input property is supplied.",
      "result": "The strict input schema rejects the call before an API request is made."
    }
  ]
