---
import BaseLayout from '../layouts/BaseLayout.astro'
import { developerReleases } from '../data/releases'
import { apiOperations } from '../lib/openapi'

const stableOperationCount = apiOperations('v1').length
const latestRelease = developerReleases[0]

const buildPaths = [
  {
    eyebrow: 'Product integration',
    title: 'Keep tasks in sync',
    description:
      'Read task changes, preserve TeamGrid revisions and apply updates without creating a second source of truth.',
    href: '/guides/sync-tasks/',
    link: 'Build a task sync',
    featured: true,
  },
  {
    eyebrow: 'Reporting',
    title: 'Export time entries',
    description:
      'Move approved time data into finance, reporting or data-warehouse workflows.',
    href: '/guides/export-time-entries/',
    link: 'Export time entries',
  },
  {
    eyebrow: 'Operations',
    title: 'Automate project setup',
    description:
      'Create repeatable project structures from a service, script or CI job.',
    href: '/guides/automate-project-setup/',
    link: 'Automate a project',
  },
  {
    eyebrow: 'AI workflows',
    title: 'Connect an assistant safely',
    description:
      'Expose a deliberately bounded set of TeamGrid tools through the local MCP server.',
    href: '/mcp/tools-and-security/',
    link: 'Review MCP access',
  },
]

const interfaces = [
  {
    id: 'api',
    label: 'API v1',
    meta: 'HTTP · OpenAPI 3.1',
    title: 'Work directly with the stable contract.',
    description:
      'Use regional HTTPS endpoints when your application owns transport, retries and data flow. Every other official TeamGrid interface follows this contract.',
    bestFor: 'Backend services, product integrations and generated clients',
    command: 'GET https://api.de.teamgrid.app/v1/tasks?limit=25',
    href: '/api/v1/',
    link: 'Read the API overview',
  },
  {
    id: 'sdk',
    label: 'TypeScript SDK',
    meta: '@teamgrid/api-client',
    title: 'Use typed resources without rebuilding HTTP.',
    description:
      'The official Node.js client handles regional routing, bounded retries, cursor iteration and versioned TeamGrid errors.',
    bestFor: 'TypeScript applications, workers and backend services',
    command: 'npm install @teamgrid/api-client',
    href: '/sdk/',
    link: 'Open the SDK guide',
  },
  {
    id: 'cli',
    label: 'CLI',
    meta: '@teamgrid/cli',
    title: 'Inspect and automate from the terminal.',
    description:
      'Run repeatable operations locally or in CI with structured output, stable exit codes and the same scoped credentials as the API.',
    bestFor: 'Operations, scripts and deployment pipelines',
    command: 'npm install --global @teamgrid/cli',
    href: '/cli/',
    link: 'Open the CLI guide',
  },
  {
    id: 'mcp',
    label: 'MCP server',
    meta: '@teamgrid/mcp-server',
    title: 'Give compatible AI clients bounded context.',
    description:
      'Run a local stdio adapter with an intentionally limited tool surface. Credentials remain local and TeamGrid permissions still apply.',
    bestFor: 'Supervised, read-oriented AI-assisted workflows',
    command: 'npx --yes @teamgrid/mcp-server',
    href: '/mcp/',
    link: 'Open the MCP guide',
  },
]
---

<BaseLayout
  title="TeamGrid Developer"
  description="Build reliable TeamGrid integrations with API v1, the TypeScript SDK, the CLI, and the TeamGrid MCP server."
>
  <main id="main-content" class="developer-home">
    <section class="home-hero">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="home-kicker home-kicker--inverse">
            <span></span>
            TeamGrid developer platform
          </p>
          <h1>Build TeamGrid into the tools your team already uses.</h1>
          <p class="home-hero__lead">
            Connect projects, tasks, time entries and workspace data through one stable,
            region-aware contract—and choose the interface that fits the work.
          </p>
          <div class="home-hero__actions">
            <a class="button button--light" href="/api/v1/quickstart/">
              Start building <span aria-hidden="true">→</span>
            </a>
            <a class="button button--ghost" href="/api/v1/reference/">Explore API v1</a>
          </div>
        </div>

        <div class="hero-workbench" aria-label="TeamGrid CLI task query">
          <div class="hero-workbench__top">
            <div>
              <span></span><span></span><span></span>
            </div>
            <strong>teamgrid</strong>
            <small>CLI</small>
          </div>
          <div class="hero-workbench__command">
            <span>~</span>
            <code>teamgrid tasks list --status in_progress --limit 3</code>
          </div>
          <div class="hero-workbench__result">
            <div class="hero-workbench__result-head">
              <span>Task</span>
              <span>Project</span>
              <span>Status</span>
            </div>
            <div>
              <strong>Launch developer portal</strong>
              <span>Platform</span>
              <em>In progress</em>
            </div>
            <div>
              <strong>Review integration scopes</strong>
              <span>Security</span>
              <em>In progress</em>
            </div>
            <div>
              <strong>Publish migration guide</strong>
              <span>API v1</span>
              <em>In progress</em>
            </div>
          </div>
          <div class="hero-workbench__footer">
            <span><i></i> api.de.teamgrid.app</span>
            <span class="hero-workbench__activity">3 results · 42 ms</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-facts" aria-label="Developer platform facts">
      <div>
        <span>Current contract</span>
        <strong>API v1 · Stable 1.0</strong>
      </div>
      <div>
        <span>Reference coverage</span>
        <strong>{stableOperationCount} documented operations</strong>
      </div>
      <div>
        <span>Production regions</span>
        <strong>Germany and United States</strong>
      </div>
      <a class="status--unknown" href="https://status.teamgrid.app/" data-live-status>
        <span class="home-facts__status-dot" data-status-dot></span>
        <span data-status-label>Status</span>
        <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="home-section home-intents">
      <div class="home-heading">
        <div>
          <p class="home-kicker">Start with the job</p>
          <h2>What do you want to build?</h2>
        </div>
        <p>
          Begin with the outcome. Each guide recommends the right interface, scopes and
          production behavior for that workflow.
        </p>
      </div>

      <div class="intent-grid">
        {buildPaths.map((path, index) => (
          <a
            class:list={['intent-card', { 'intent-card--featured': path.featured }]}
            href={path.href}
          >
            <div class="intent-card__number">0{index + 1}</div>
            <div>
              <span>{path.eyebrow}</span>
              <h3>{path.title}</h3>
              <p>{path.description}</p>
              <strong>{path.link} <span aria-hidden="true">→</span></strong>
            </div>
            {path.featured && (
              <div class="intent-card__sequence" aria-hidden="true">
                <div class="intent-card__sequence-header">
                  <span>Change sequence</span>
                  <span>Completed</span>
                </div>
                <div class="intent-card__sequence-body">
                  <div class="intent-card__sequence-row">
                    <span class="intent-card__sequence-index">01</span>
                    <div>
                      <strong>Task updated</strong>
                      <code>revision 184</code>
                    </div>
                    <span class="intent-card__sequence-state">Recorded</span>
                  </div>
                  <div class="intent-card__sequence-row">
                    <span class="intent-card__sequence-index">02</span>
                    <div>
                      <strong>Change read</strong>
                      <code>cursor saved</code>
                    </div>
                    <span class="intent-card__sequence-state">Delivered</span>
                  </div>
                  <div class="intent-card__sequence-row">
                    <span class="intent-card__sequence-index">03</span>
                    <div>
                      <strong>Integration applied</strong>
                      <code>200 · no conflict</code>
                    </div>
                    <span class="intent-card__sequence-state">In sync</span>
                  </div>
                </div>
                <div class="intent-card__sequence-footer">
                  The next read resumes after revision 184.
                </div>
              </div>
            )}
          </a>
        ))}
      </div>
    </section>

    <section class="home-flow">
      <div class="home-flow__inner">
        <div class="home-flow__copy">
          <p class="home-kicker">One governed data path</p>
          <h2>Your integration reaches the right workspace, in the right region.</h2>
          <p>
            TeamGrid credentials carry a location hint and explicit scopes. Official clients use
            both locally, then connect directly to the assigned production region.
          </p>
          <a class="text-link" href="/api/v1/regions/">
            Understand regional routing <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="platform-flow" aria-label="TeamGrid integration data flow">
          <div class="platform-flow__stage platform-flow__workspace">
            <span>Workspace</span>
            <strong>TeamGrid</strong>
            <div>
              <code>Tasks</code>
              <code>Projects</code>
              <code>Time entries</code>
              <code>Contacts</code>
            </div>
          </div>
          <div class="platform-flow__connector" aria-hidden="true">
            <span></span><i>HTTPS</i><span></span>
          </div>
          <div class="platform-flow__stage platform-flow__credential">
            <span>Credential</span>
            <strong>Scoped access</strong>
            <div>
              <code>tasks:read</code>
              <code>region: de</code>
            </div>
          </div>
          <div class="platform-flow__connector" aria-hidden="true">
            <span></span><i>v1</i><span></span>
          </div>
          <div class="platform-flow__stage platform-flow__client">
            <span>Your workflow</span>
            <strong>Use one interface</strong>
            <div>
              <code>API</code>
              <code>SDK</code>
              <code>CLI</code>
              <code>MCP</code>
            </div>
          </div>
        </div>

        <div class="home-flow__principles">
          <div>
            <span>01</span>
            <strong>Data stays regional</strong>
            <p>Requests go straight to the workspace’s assigned cell.</p>
          </div>
          <div>
            <span>02</span>
            <strong>Authority stays explicit</strong>
            <p>Granular scopes bound every credential and official client.</p>
          </div>
          <div>
            <span>03</span>
            <strong>Writes stay recoverable</strong>
            <p>Revisions and idempotency make conflicts and retries visible.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="home-lab">
      <div class="home-lab__inner">
        <div class="home-lab__copy">
          <p class="home-kicker home-kicker--inverse">Your first request</p>
          <h2>Verify the contract in a few minutes.</h2>
          <p>
            The workspace endpoint confirms authentication, regional routing and the active API
            version without changing any TeamGrid data.
          </p>
          <ol>
            <li>
              <span>1</span>
              <div>
                <strong>Create a scoped credential</strong>
                <small>Open Developer settings in an unlocked workspace.</small>
              </div>
            </li>
            <li>
              <span>2</span>
              <div>
                <strong>Keep the token in an environment variable</strong>
                <small>The credential is shown only once.</small>
              </div>
            </li>
            <li>
              <span>3</span>
              <div>
                <strong>Call the regional workspace endpoint</strong>
                <small>A successful response identifies the workspace and cell.</small>
              </div>
            </li>
          </ol>
          <a class="text-link text-link--inverse" href="/api/v1/quickstart/">
            Follow the complete quickstart <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="request-lab" data-request-lab>
          <div class="request-lab__top">
            <span>Read-only request</span>
            <div class="request-lab__region" aria-label="Select API region">
              <button type="button" class="is-active" aria-pressed="true" data-region="de">DE</button>
              <button type="button" aria-pressed="false" data-region="us">US</button>
            </div>
          </div>
          <div class="request-lab__tabs" role="tablist" aria-label="Request language">
            <button
              id="request-tab-curl"
              type="button"
              role="tab"
              aria-controls="request-panel-curl"
              aria-selected="true"
              data-code-tab="curl"
            >cURL</button>
            <button
              id="request-tab-typescript"
              type="button"
              role="tab"
              aria-controls="request-panel-typescript"
              aria-selected="false"
              tabindex="-1"
              data-code-tab="typescript"
            >TypeScript</button>
            <button
              id="request-tab-cli"
              type="button"
              role="tab"
              aria-controls="request-panel-cli"
              aria-selected="false"
              tabindex="-1"
              data-code-tab="cli"
            >CLI</button>
          </div>
          <div class="request-lab__code">
            <pre id="request-panel-curl" role="tabpanel" aria-labelledby="request-tab-curl" data-code-panel="curl"><code><span class="code-command">curl</span> --fail-with-body \
  --header <span class="code-string">"Authorization: Bearer $TEAMGRID_API_TOKEN"</span> \
  --header <span class="code-string">"Accept: application/json"</span> \
  <span class="code-url" data-regional-url>https://api.de.teamgrid.app/v1/workspace</span></code></pre>
            <pre id="request-panel-typescript" role="tabpanel" aria-labelledby="request-tab-typescript" data-code-panel="typescript" hidden><code><span class="code-command">const</span> client = <span class="code-command">new</span> TeamGridClient({`{`}
  token: process.env.TEAMGRID_API_TOKEN,
{`}`}

<span class="code-command">const</span> workspace = <span class="code-command">await</span> client.workspace.get()</code></pre>
            <pre id="request-panel-cli" role="tabpanel" aria-labelledby="request-tab-cli" data-code-panel="cli" hidden><code><span class="code-command">teamgrid</span> workspace get --output json</code></pre>
            <button type="button" data-copy-request>Copy</button>
          </div>
          <div class="request-lab__response">
            <div>
              <span><i></i> 200 OK</span>
              <small>application/json</small>
            </div>
            <pre><code>{`{`}
  <span class="json-key">"id"</span>: <span class="json-value">"qJfnmjBvWpfbEsLEa"</span>,
  <span class="json-key">"name"</span>: <span class="json-value">"Acme Inc."</span>,
  <span class="json-key">"region"</span>: <span class="json-value" data-response-region>"de"</span>,
  <span class="json-key">"cell"</span>: <span class="json-value" data-response-cell>"de-nbg-001"</span>
{`}`}</code></pre>
          </div>
          <div class="request-lab__note">
            <span>No credential is entered or sent from this page.</span>
            <span data-region-label>German region</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-section home-interfaces">
      <div class="home-heading">
        <div>
          <p class="home-kicker">Choose an interface</p>
          <h2>One contract. Four ways to work.</h2>
        </div>
        <p>
          Authentication, regional routing and resource semantics remain the same. Change the
          interface without learning a second TeamGrid platform.
        </p>
      </div>

      <div class="interface-switcher" data-interface-switcher>
        <div class="interface-switcher__tabs" role="tablist" aria-label="TeamGrid interfaces">
          {interfaces.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`interface-tab-${item.id}`}
              aria-controls={`interface-panel-${item.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
              data-interface-tab={item.id}
            >
              <span>0{index + 1}</span>
              <strong>{item.label}</strong>
              <small>{item.meta}</small>
            </button>
          ))}
        </div>
        <div class="interface-switcher__panels">
          {interfaces.map((item, index) => (
            <article
              id={`interface-panel-${item.id}`}
              role="tabpanel"
              aria-labelledby={`interface-tab-${item.id}`}
              data-interface-panel={item.id}
              hidden={index !== 0}
            >
              <div>
                <span>Best for</span>
                <strong>{item.bestFor}</strong>
              </div>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a class="text-link" href={item.href}>
                  {item.link} <span aria-hidden="true">→</span>
                </a>
              </div>
              <code>{item.command}</code>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="production-guides" class="home-resources">
      <div class="home-resources__inner">
        <div class="home-resources__heading">
          <p class="home-kicker">Continue with a real workflow</p>
          <h2>Guides written for production work.</h2>
          <p>
            Follow complete implementation paths for the work integrations need to handle beyond
            the first successful request.
          </p>
        </div>

        <aside class="home-release">
          <div class="home-release__identity">
            <span>Latest release · {latestRelease.date}</span>
            <strong>{latestRelease.title}</strong>
            <code>{latestRelease.version}</code>
          </div>
          <div class="home-release__details">
            <p>{latestRelease.description}</p>
            <ul>
              {latestRelease.highlights.slice(0, 2).map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
          <a href="/changelog/">Read the changelog <span aria-hidden="true">→</span></a>
        </aside>

        <div class="home-resources__guides">
          <a href="/guides/reliable-webhooks/">
            <span>Webhooks</span>
            <strong>Build a reliable webhook consumer</strong>
            <p>Verify signatures, acknowledge quickly and process deliveries idempotently.</p>
            <em>Read guide <span aria-hidden="true">→</span></em>
          </a>
          <a href="/guides/upload-a-file/">
            <span>Files</span>
            <strong>Upload and attach a file</strong>
            <p>Request an upload target, transfer bytes and attach the completed file safely.</p>
            <em>Read guide <span aria-hidden="true">→</span></em>
          </a>
          <a href="/guides/audit-users-and-access/">
            <span>Administration</span>
            <strong>Audit users and access</strong>
            <p>Review workspace membership and build a repeatable access report.</p>
            <em>Read guide <span aria-hidden="true">→</span></em>
          </a>
        </div>
      </div>
    </section>

    <section class="home-finish">
      <div>
        <p class="home-kicker">Ready when you are</p>
        <h2>Make the first request, then build from the contract.</h2>
      </div>
      <div>
        <a class="button button--dark" href="/api/v1/quickstart/">
          Open the quickstart <span aria-hidden="true">→</span>
        </a>
        <a class="button button--outline" href="/api/v1/reference/">Browse API v1</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const requestLab = document.querySelector<HTMLElement>('[data-request-lab]')
  const codeTabs = requestLab?.querySelectorAll<HTMLButtonElement>('[data-code-tab]') || []
  const codePanels = requestLab?.querySelectorAll<HTMLElement>('[data-code-panel]') || []

  const selectCodeTab = (tab: HTMLButtonElement) => {
    const selected = tab.dataset.codeTab
    codeTabs.forEach((candidate) => {
      const active = candidate === tab
      candidate.setAttribute('aria-selected', String(active))
      candidate.tabIndex = active ? 0 : -1
    })
    codePanels.forEach((panel) => {
      panel.hidden = panel.dataset.codePanel !== selected
    })
  }

  codeTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectCodeTab(tab))
    tab.addEventListener('keydown', (event) => {
      const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End']
      if (!keys.includes(event.key)) return
      event.preventDefault()
      let nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? codeTabs.length - 1 : index
      if (event.key === 'ArrowLeft') nextIndex = (index - 1 + codeTabs.length) % codeTabs.length
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % codeTabs.length
      const nextTab = codeTabs[nextIndex]
      if (!nextTab) return
      selectCodeTab(nextTab)
      nextTab.focus()
    })
  })

  requestLab?.querySelectorAll<HTMLButtonElement>('[data-region]').forEach((button) => {
    button.addEventListener('click', () => {
      const region = button.dataset.region === 'us' ? 'us' : 'de'
      requestLab.querySelectorAll<HTMLButtonElement>('[data-region]').forEach((candidate) => {
        const active = candidate === button
        candidate.classList.toggle('is-active', active)
        candidate.setAttribute('aria-pressed', String(active))
      })
      const url = requestLab.querySelector<HTMLElement>('[data-regional-url]')
      if (url) url.textContent = `https://api.${region}.teamgrid.app/v1/workspace`
      const label = requestLab.querySelector<HTMLElement>('[data-region-label]')
      if (label) label.textContent = region === 'us' ? 'United States region' : 'German region'
      const responseRegion = requestLab.querySelector<HTMLElement>('[data-response-region]')
      if (responseRegion) responseRegion.textContent = `"${region}"`
      const responseCell = requestLab.querySelector<HTMLElement>('[data-response-cell]')
      if (responseCell) {
        responseCell.textContent = region === 'us' ? '"us-iad-001"' : '"de-nbg-001"'
      }
    })
  })

  const copyButton = requestLab?.querySelector<HTMLButtonElement>('[data-copy-request]')
  copyButton?.addEventListener('click', async () => {
    const activeCode = requestLab?.querySelector<HTMLElement>('[data-code-panel]:not([hidden])')
    await navigator.clipboard.writeText(activeCode?.textContent || '')
    copyButton.textContent = 'Copied'
    window.setTimeout(() => {
      copyButton.textContent = 'Copy'
    }, 1600)
  })

  const interfaceSwitcher = document.querySelector<HTMLElement>('[data-interface-switcher]')
  const interfaceTabs =
    interfaceSwitcher?.querySelectorAll<HTMLButtonElement>('[data-interface-tab]') || []
  const interfacePanels =
    interfaceSwitcher?.querySelectorAll<HTMLElement>('[data-interface-panel]') || []

  const selectInterfaceTab = (tab: HTMLButtonElement) => {
    const selected = tab.dataset.interfaceTab
    interfaceTabs.forEach((candidate) => {
      const active = candidate === tab
      candidate.setAttribute('aria-selected', String(active))
      candidate.tabIndex = active ? 0 : -1
    })
    interfacePanels.forEach((panel) => {
      panel.hidden = panel.dataset.interfacePanel !== selected
    })
  }

  interfaceTabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectInterfaceTab(tab))
    tab.addEventListener('keydown', (event) => {
      const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End']
      if (!keys.includes(event.key)) return
      event.preventDefault()
      let nextIndex =
        event.key === 'Home' ? 0 : event.key === 'End' ? interfaceTabs.length - 1 : index
      if (event.key === 'ArrowLeft') {
        nextIndex = (index - 1 + interfaceTabs.length) % interfaceTabs.length
      }
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % interfaceTabs.length
      const nextTab = interfaceTabs[nextIndex]
      if (!nextTab) return
      selectInterfaceTab(nextTab)
      nextTab.focus()
    })
  })
</script>
