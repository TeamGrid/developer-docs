---
import { isCurrentPath, navigation } from '../data/navigation'

interface Props {
  pathname: string
}
const { pathname } = Astro.props
---

<aside class="docs-sidebar" data-sidebar>
  <div class="docs-sidebar__mobile-head">
    <span>Documentation</span>
    <button type="button" data-sidebar-close aria-label="Close documentation navigation">×</button>
  </div>
  <nav aria-label="Documentation">
    {
      navigation.map((group) => {
        const containsCurrent = group.items.some((item) => isCurrentPath(pathname, item.href))
        return (
          <details open={containsCurrent || group.label === 'Start here'}>
            <summary>{group.label}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m5 6 3 3 3-3" /></svg></summary>
            <div>
              {group.items.map((item) => (
                <a class:list={{ 'is-current': isCurrentPath(pathname, item.href) }} href={item.href}>
                  {item.label}
                </a>
              ))}
            </div>
          </details>
        )
      })
    }
  </nav>
</aside>
