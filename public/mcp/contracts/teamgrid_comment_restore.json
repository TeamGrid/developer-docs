  "profileOutputSchemas": {},
  "exposure": "gated-write",
  "apiOperations": [
    {
      "href": "/api/v1/reference/operations/restorecomment/",
      "method": "POST",
      "operationId": "restoreComment",
      "path": "/comments/{id}/restore"
    }
  ],
  "availableIn": [
    "full",
    "content-write"
  ],
  "baseProfile": "full",
  "description": "Restore a comment. Changes the selected workspace under current API permissions. Read the target first; submit its exact ETag. On conflict, review the current state before making a new decision. May notify other people.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspaceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Workspace returned by teamgrid_workspace_get and selected for this exact action."
      },
      "id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "expectedRevision": {
        "pattern": "^\"cmt1-[a-f0-9]{64}\"$",
        "type": "string",
        "description": "Exact strong ETag (including quotes) from the read reviewed for this action. Never replace it automatically after a conflict."
      }
    },
    "required": [
      "workspaceId",
      "id",
      "expectedRevision"
    ],
    "additionalProperties": false
  },
  "profileInputSchemas": {},
  "name": "teamgrid_comment_restore",
  "scopes": {
    "optional": [],
    "conditional": [
      "contacts:read",
      "projects:read",
      "tasks:read"
    ],
    "required": [
      "comments:write",
      "workspace:read",
      "comments:read"
    ]
  },
  "security": {
    "classification": "workspace-mutation",
    "summary": "This changes workspace state and may trigger business or external effects. Use its exact scope, revision and idempotency contract; profile selection grants no authority."
  },
  "output": {
    "format": "A compact mutation receipt includes target and revision when available; outcome metadata distinguishes accepted, complete, partial and uncertain results.",
