  "profileOutputSchemas": {},
  "exposure": "read",
  "apiOperations": [
    {
      "href": "/api/v1/reference/operations/getdocument/",
      "method": "GET",
      "operationId": "getDocument",
      "path": "/documents/{id}"
    }
  ],
  "availableIn": [
    "context",
    "work",
    "full",
    "content-write"
  ],
  "baseProfile": "full",
  "description": "Get a document. Content is a bounded chunk, not necessarily the whole document. Continue with contentOffset=meta.contentPage.nextOffset and expectedRevision=meta.etag until nextOffset is null. Never infer omitted content or overwrite a document from an incomplete read.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "id": {
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
      },
      "contentOffset": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1048576,
        "description": "UTF-16 offset from meta.contentPage.nextOffset. Continuations require expectedRevision."
      },
      "contentLimit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16384,
        "default": 16384
      },
      "expectedRevision": {
        "type": "string",
        "minLength": 3,
        "maxLength": 258,
        "pattern": "^\"[\\x21\\x23-\\x7e]+\"$",
        "description": "Exact meta.etag from the first chunk; prevents mixing document versions."
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "profileInputSchemas": {},
  "name": "teamgrid_document_get",
  "scopes": {
    "optional": [],
    "conditional": [],
