  "baseProfile": "full",
  "description": "Create an asynchronous export. Changes the selected workspace under current API permissions. Reuse the same idempotencyKey and payload for the same intent. Administrative action: review the exact target and access impact with the user.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspaceId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Workspace returned by teamgrid_workspace_get and selected for this exact action."
      },
      "idempotencyKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[\\x21-\\x7e]+$",
        "description": "Stable key for this exact intent. Retain and reuse the same key and payload after a timeout; a timeout does not prove failure."
      },
      "data": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "createdAtFrom"
                    ]
                  },
                  {
                    "required": [
                      "createdAtTo"
                    ]
                  }
                ]
              }
            },
            "if": {
              "properties": {
                "resourceType": {
                  "const": "auditEvents"
                }
              },
              "required": [
                "resourceType"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "includeArchived"
                    ]
                  },
                  {
                    "required": [
                      "updatedFrom"
                    ]
                  },
                  {
                    "required": [
                      "updatedUntil"
                    ]
                  }
                ]
              },
              "required": [
                "createdAtTo"
              ]
            }
          }
        ],
        "properties": {
          "createdAtFrom": {
            "format": "date-time",
            "type": "string",
            "description": "ISO 8601 timestamp for created at from."
          },
          "createdAtTo": {
            "format": "date-time",
            "type": "string",
            "description": "ISO 8601 timestamp for created at to."
          },
          "fields": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true,
            "description": "The fields associated with this export."
          },
          "fileName": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string",
            "description": "Original or user-visible name of the file."
          },
          "format": {
            "const": "csv",
            "type": "string",
            "description": "The format associated with this export."
          },
          "includeArchived": {
            "type": "boolean",
            "description": "Whether include archived applies to this export."
          },
          "maxRows": {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer",
            "description": "The max rows associated with this export."
          },
          "resourceType": {
            "enum": [
              "auditEvents",
              "contacts",
              "projects",
              "taskRecurrences",
              "tasks",
              "timeEntries"
            ],
            "type": "string",
            "description": "Canonical TeamGrid resource type."
          },
          "updatedFrom": {
            "format": "date-time",
            "type": "string",
            "description": "ISO 8601 timestamp for updated from."
          },
          "updatedUntil": {
            "format": "date-time",
            "type": "string",
            "description": "ISO 8601 timestamp for updated until."
          }
        },
        "required": [
          "resourceType"
        ],
        "type": "object",
        "description": "Public API representation of export."
