<section class="credential-deep-link" data-credential-link>
  <div>
    <span>Open the right workspace</span>
    <h2>Create a developer credential</h2>
    <p>Enter the workspace slug from your TeamGrid URL. It stays in this browser and is never sent to the documentation site.</p>
  </div>
  <form>
    <label>
      <span>Workspace slug</span>
      <input
        type="text"
        inputmode="url"
        autocomplete="off"
        placeholder="acme-inc"
        pattern="[a-z0-9][a-z0-9-]*"
        data-workspace-slug
      />
    </label>
    <a class="button button--primary is-disabled" href="#" aria-disabled="true" data-credential-target>
      Open Developer settings
    </a>
  </form>
  <small>Expected TeamGrid path: /&lt;workspace&gt;/settings/team/developer</small>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-credential-link]').forEach((component) => {
    const input = component.querySelector<HTMLInputElement>('[data-workspace-slug]')
    const target = component.querySelector<HTMLAnchorElement>('[data-credential-target]')
    input?.addEventListener('input', () => {
      if (!target) return
      const slug = input.value.trim().toLowerCase()
      const valid = /^[a-z0-9][a-z0-9-]*$/.test(slug)
      target.href = valid
        ? `https://web.teamgrid.app/${encodeURIComponent(slug)}/settings/team/developer`
        : '#'
      target.classList.toggle('is-disabled', !valid)
      target.setAttribute('aria-disabled', String(!valid))
    })
  })
</script>
