---
import BaseLayout from '../layouts/BaseLayout.astro'
import { apiOperations } from '../lib/openapi'

const stableOperationCount = apiOperations('v1').length
---

<BaseLayout
  title="TeamGrid Developer"
  description="Build reliable TeamGrid integrations with API v1, the TypeScript SDK, the CLI, and the TeamGrid MCP server."
>
  <main id="main-content">
    <section class="home-hero">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="home-hero__eyebrow"><span></span> Developer platform · API v1 stable</p>
          <h1>TeamGrid, built into your workflow.</h1>
          <p>
            Connect projects, tasks, time entries and workspace data to the tools your team already
            uses. Start with the API or work through our official TypeScript, CLI and MCP clients.
          </p>
          <div class="home-hero__actions">
            <a class="button button--light" href="/api/v1/quickstart/">Make your first request <span>→</span></a>
            <a class="button button--ghost" href="/api/v1/reference/">Browse API v1</a>
          </div>
        </div>
        <div class="terminal" aria-label="TeamGrid CLI example">
          <div class="terminal__head">
            <div><span></span><span></span><span></span></div>
            <span>teamgrid</span>
            <span>CLI</span>
          </div>
          <div class="terminal__body">
            <div class="terminal__command">
              <span class="terminal__prompt">~</span>
              <code>teamgrid tasks list --limit 2</code>
            </div>
            <div class="terminal__result">
              <div><span class="json-key">"data"</span>: [</div>
              <div class="terminal__indent">{`{`}</div>
              <div class="terminal__indent2"><span class="json-key">"title"</span>: <span class="json-value">"Launch developer portal"</span>,</div>
              <div class="terminal__indent2"><span class="json-key">"status"</span>: <span class="json-value">"in_progress"</span></div>
              <div class="terminal__indent">{`}`}</div>
              <div>]</div>
            </div>
            <div class="terminal__meta">
              <span>✓ api.de.teamgrid.app</span>
              <span>42 ms</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="home-trust">
      <div>
        <span>Current contract</span>
        <strong>API v1 · Stable</strong>
      </div>
      <div>
        <span>Reference coverage</span>
        <strong>{stableOperationCount} documented operations</strong>
      </div>
      <div>
        <span>Production regions</span>
        <strong>Germany and United States</strong>
      </div>
      <a class="status--unknown" href="https://status.teamgrid.app/" data-live-status>
        <span class="home-trust__status-dot" data-status-dot></span>
        <span data-status-label>Status</span>
        <span>↗</span>
      </a>
    </section>

    <section class="home-section interfaces-section">
      <div class="home-section__heading">
        <div class="home-section__title">
          <p>Choose an interface</p>
          <h2>The same TeamGrid model, wherever you work.</h2>
        </div>
        <span>
          Each official client follows the same authentication, regional routing and resource
          semantics. Choose the surface that fits the job without learning a second platform.
        </span>
      </div>
      <div class="interface-list">
        <a href="/api/v1/" class="interface-row is-featured">
          <div class="interface-row__index">01</div>
          <div class="interface-row__title">
            <strong>API v1</strong>
            <span>HTTP · OpenAPI 3.1 · Stable</span>
          </div>
          <div class="interface-row__body">
            <p>Call the regional API directly when you need complete control over transport, retries and data flow.</p>
            <small>Best for product integrations and backend services</small>
          </div>
          <span class="interface-row__arrow">→</span>
        </a>
        <a href="/sdk/" class="interface-row">
          <div class="interface-row__index">02</div>
          <div class="interface-row__title">
            <strong>TypeScript SDK</strong>
            <span>@teamgrid/api-client · Node.js 22–24</span>
          </div>
          <div class="interface-row__body">
            <p>Use typed resource clients, cursor iterators and stable error classes without rebuilding the HTTP layer.</p>
            <small>Best for TypeScript applications and services</small>
          </div>
          <span class="interface-row__arrow">→</span>
        </a>
        <a href="/cli/" class="interface-row">
          <div class="interface-row__index">03</div>
          <div class="interface-row__title">
            <strong>TeamGrid CLI</strong>
            <span>@teamgrid/cli · Terminal and CI</span>
          </div>
          <div class="interface-row__body">
            <p>Inspect live data, run repeatable operations and produce structured output from scripts or CI jobs.</p>
            <small>Best for operators, scripts and deployment pipelines</small>
          </div>
          <span class="interface-row__arrow">→</span>
        </a>
        <a href="/mcp/" class="interface-row">
          <div class="interface-row__index">04</div>
          <div class="interface-row__title">
            <strong>MCP server</strong>
            <span>@teamgrid/mcp-server · Local stdio</span>
          </div>
          <div class="interface-row__body">
            <p>Expose an intentionally limited set of TeamGrid tools to compatible AI clients through a local process.</p>
            <small>Best for supervised AI-assisted workflows</small>
          </div>
          <span class="interface-row__arrow">→</span>
        </a>
      </div>
      <div class="interface-note">
        <span>One credential model</span>
        <p>Region hints and scopes travel with the credential, so every official client reaches the correct cell and applies the same authority.</p>
        <a href="/guides/choose-an-interface/">Compare the interfaces →</a>
      </div>
    </section>

    <section class="home-section production-section">
      <div class="production-section__intro">
        <div class="home-section__title">
          <p>Production behavior</p>
          <h2>Built for the realities of production.</h2>
        </div>
        <span>
          The public contract makes data location, authorization and concurrent writes explicit.
          Your integration can behave predictably without knowing how TeamGrid operates each cell.
        </span>
      </div>
      <div class="principle-grid">
        <article>
          <div class="principle-grid__meta"><span>01</span><em>Data residency</em></div>
          <h3>The correct region, from the first request</h3>
          <p>Credentials contain a location hint. Official clients use it locally and connect straight to the workspace’s regional API endpoint.</p>
          <a href="/api/v1/regions/">Understand regional routing →</a>
        </article>
        <article>
          <div class="principle-grid__meta"><span>02</span><em>Authorization</em></div>
          <h3>Only the access an integration needs</h3>
          <p>Reveal-once credentials and granular scopes keep service accounts, scripts and tools within a deliberate boundary.</p>
          <a href="/api/v1/authentication/">Plan credentials and scopes →</a>
        </article>
        <article>
          <div class="principle-grid__meta"><span>03</span><em>Write safety</em></div>
          <h3>Conflicts are visible, not silently overwritten</h3>
          <p>Resource revisions, idempotency keys and explicit operations help integrations recover cleanly from retries and concurrent changes.</p>
          <a href="/api/v1/resource-concurrency/">Handle concurrent writes →</a>
        </article>
      </div>
    </section>

    <section class="home-section quickstart-section">
      <div class="quickstart-section__copy">
        <p>Your first request</p>
        <h2>Start with one scoped credential.</h2>
        <span class="quickstart-section__intro">
          The quickest useful check is the workspace endpoint: it confirms authentication,
          regional routing and the active API contract in one response.
        </span>
        <ol>
          <li><span>1</span><div><strong>Create a credential in TeamGrid</strong><small>Select only the scopes required by your integration and store the token when it is revealed.</small></div></li>
          <li><span>2</span><div><strong>Call the workspace endpoint</strong><small>The credential identifies the correct regional ingress for official clients.</small></div></li>
          <li><span>3</span><div><strong>Move to the resource you need</strong><small>Continue with projects, tasks, time entries or one of the other documented resources.</small></div></li>
        </ol>
        <a class="text-link" href="/api/v1/quickstart/">Follow the complete quickstart <span>→</span></a>
      </div>
      <div class="request-example">
        <div class="request-example__head">
          <span><b>GET</b> /v1/workspace</span>
          <button type="button" data-copy-request>Copy</button>
        </div>
        <pre><code data-request-code><span class="code-command">curl</span> --fail-with-body \
  --header <span class="code-string">"Authorization: Bearer $TEAMGRID_API_TOKEN"</span> \
  --header <span class="code-string">'Accept: application/json'</span> \
  <span class="code-url">https://api.de.teamgrid.app/v1/workspace</span></code></pre>
        <div class="request-example__response">
          <span><i></i> 200 OK</span>
          <span>application/json</span>
        </div>
      </div>
    </section>

    <section class="home-cta">
      <div>
        <p>Continue from here</p>
        <h2>Read the contract, then build against it.</h2>
        <span>Start with a guided request or go directly to the complete API reference.</span>
      </div>
      <div>
        <a class="button button--dark" href="/api/v1/quickstart/">Open the quickstart <span>→</span></a>
        <a class="button button--outline" href="/api/v1/reference/">Browse API v1</a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-request]')
  copyButton?.addEventListener('click', async () => {
    const code = document.querySelector('[data-request-code]')?.textContent || ''
    await navigator.clipboard.writeText(code)
    copyButton.textContent = 'Copied'
    window.setTimeout(() => { copyButton.textContent = 'Copy' }, 1600)
  })
</script>
